// ABAPForge — Prisma Schema
// Simulated SAP system: repository objects + DDIC + demo DB + logs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local dev: file:./db/app.db (set in .env). Free cloud deploy (Neon/Supabase):
  // change provider to "postgresql" and set DATABASE_URL to the connection string.
  url      = env("DATABASE_URL")
}

// ── Syllabus / Learning ────────────────────────────────────────────────
model Topic {
  id        Int              @id @default(autoincrement())
  srNo      Int // 1..10 from HCLTech syllabus
  code      String           @unique // e.g. "TOPIC_01"
  title     String
  summary   String
  details   String           @default("") // markdown: concepts, key points
  paradigm  String           @default("BOTH") // POP | OOP | BOTH | CONCEPT
  category  String           @default("CORE") // CORE | REPORTING | MODERN
  programs  Program[]
  tables    DbTable[]
  functions FunctionModule[]
}

// ── Repository objects (programs / classes / includes / FGroups) ───────
model Program {
  id          String         @id @default(cuid())
  name        String         @unique // Z_REPORT_01 / ZCL_CLASS / Z_INCLUDE
  title       String         @default("")
  description String         @default("")
  type        String         @default("REPORT") // REPORT | CLASS | INCLUDE | FUNCTION_GROUP
  paradigm    String         @default("BOTH") // POP | OOP | BOTH
  environment String         @default("STANDARD") // STANDARD | MODERN
  modernKind  String         @default("ABAP") // ABAP | CDS | RAP | AMDP
  source      String         @default("")
  isExample   Boolean        @default(false)
  tags        String         @default("")
  version     Int            @default(1)
  executions  Int            @default(0)
  topicId     Int?
  topic       Topic?         @relation(fields: [topicId], references: [id])
  // null + isExample=true  → shared, read-only training example
  // null + isExample=false → unclaimed legacy object (owner-only after migration)
  // set                    → private program owned by that user
  ownerId     String?
  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  logs        ExecutionLog[]

  @@index([ownerId])
}

// ── Data Dictionary (SE11) ─────────────────────────────────────────────
model DbTable {
  id          Int     @id @default(autoincrement())
  name        String  @unique // SFLIGHT, MARA ...
  description String  @default("")
  isSap       Boolean @default(true) // part of simulated SAP model
  fields      String  @default("[]") // JSON: [{name,type,length,decimals,key,text}]
  topicId     Int?
  topic       Topic?  @relation(fields: [topicId], references: [id])
  rows        DbRow[]
}

// Simulated DB content (rows of the DDIC tables)
model DbRow {
  id      Int     @id @default(autoincrement())
  tableId Int
  table   DbTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  data    String  @default("{}") // JSON {field: value}
  seq     Int     @default(0)

  @@index([tableId])
}

// ── Function Builder (SE37) ────────────────────────────────────────────
model FunctionGroup {
  id        String   @id @default(cuid())
  name      String   @unique // ZFLIGHT_GROUP
  shortText String   @default("")
  isExample Boolean  @default(false)
  // null + isExample=true  → shared training group, read-only
  // set                    → private group owned by that user
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy String   @default("SAP")
  changedOn String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model FunctionModule {
  id             String  @id @default(cuid())
  name           String  @unique // Z_GET_FLIGHT_DETAILS
  groupName      String  @default("ZFLIGHT_GROUP")
  title          String  @default("")
  importParams   String  @default("[]") // JSON param specs
  exportParams   String  @default("[]")
  changingParams String  @default("[]")
  tablesParams   String  @default("[]")
  exceptions     String  @default("[]") // JSON string[] (documented RAISE names)
  source         String  @default("")
  isExample      Boolean @default(false)
  active         Boolean @default(true)
  // null + isExample=true  → shared training module, read-only
  // set                    → private module owned by that user
  ownerId        String?
  owner          User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy      String  @default("SAP")
  changedBy      String  @default("")
  changedOn      String  @default("")
  topicId        Int?
  topic          Topic?  @relation(fields: [topicId], references: [id])

  @@index([ownerId])
  @@index([groupName])
}

// ── Execution log (SM21-ish) ───────────────────────────────────────────
model ExecutionLog {
  id          Int      @id @default(autoincrement())
  programId   String?
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programName String
  // Kept on account deletion (SetNull) so aggregate health metrics survive
  // without retaining a link to the deleted identity.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      String // SUCCESS | ERROR | SYNTAX_ERROR
  durationMs  Int      @default(0)
  message     String   @default("")
  // ABAP runtime error id (e.g. CX_SY_ZERODIVIDE) for the ST22 dump analysis
  errorType   String?
  errorLine   Int?
  listLines   Int      @default(0)
  hadAlv      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ── User master (SAP-style logon: user + password) ─────────────────────
model User {
  id              String           @id @default(cuid())
  username        String           @unique // stored uppercase, like SAP user names
  passwordHash    String // scrypt: "<salt-hex>:<hash-hex>" (legacy); "clerk-only" for Clerk accounts
  email           String?          @unique // verified Clerk email or owner-verified migration mapping
  clerkId         String?          @unique // Clerk user id; links the Clerk identity to this SAP user
  displayName     String           @default("")
  role            String           @default("USER") // USER | OWNER (server-managed only)
  suspended       Boolean          @default(false)
  sessionVersion  Int              @default(1) // bump to revoke every existing session
  createdAt       DateTime         @default(now())
  lastLoginAt     DateTime?
  programs        Program[]
  functionGroups  FunctionGroup[]
  functionModules FunctionModule[]
  favorites       UserFavorite[]
  logs            ExecutionLog[]
}

// ── Per-user Easy Access favorites ─────────────────────────────────────
model UserFavorite {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectType String // PROGRAM | CLASS | TABLE | FM | TOPIC
  objectName String
  label      String   @default("")
  createdAt  DateTime @default(now())

  @@unique([userId, objectType, objectName])
  @@index([userId])
}

// ── Immutable administrative audit trail ───────────────────────────────
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String // snapshot; intentionally not a foreign key
  actorName  String
  action     String // e.g. USER_SUSPEND, USER_DELETE, SESSION_REVOKE
  targetType String   @default("")
  targetId   String   @default("")
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
