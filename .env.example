# ── ABAP-Studio — environment ──────────────────────────────────────
# Copy this file to `.env` and adjust. (SQLite path is relative to prisma/)

# LOCAL DEVELOPMENT (default). The database file is git-ignored and created by
# `bun run db:push`; shared content is auto-seeded on the first request.
DATABASE_URL="file:./db/app.db"

# FREE CLOUD DEPLOYMENT (Vercel Hobby + Turso free libSQL) — see DEPLOY.md
# Set both in Vercel → Project → Settings → Environment Variables.
# Also export them in your shell when running `bun run deploy:db` (schema + content push).
# TURSO_DATABASE_URL="libsql://your-db-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."      # created with: turso db tokens create <db>

# ── Owner administration ───────────────────────────────────────────────
# The single owner account must have role=OWNER in the User table
# (scripts/provision-owner.ts) and a verified email matching OWNER_EMAIL.
# Production fails closed when OWNER_EMAIL is missing. OWNER_USERNAME is only
# a non-production local/unit-test fallback and is never accepted on Vercel or
# when NODE_ENV=production.
# OWNER_EMAIL="owner@example.com"
# OWNER_USERNAME="YOUR_OWNER_NAME"

# ── Clerk authentication ───────────────────────────────────────────────
# Clerk is the only identity provider: Email OTP + Google with verified-email
# linking. Use development keys locally and production keys in Vercel. Never
# commit, print or paste a secret key.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# CLERK_WEBHOOK_SECRET="whsec_..."   # Clerk → Webhooks signing secret
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ── Disposable automated-test session broker ───────────────────────────
# Never set these in Vercel or against a real database. The broker disables
# itself when VERCEL or TURSO_DATABASE_URL is present. Test scripts generate a
# fresh secret automatically; these are documented only for manual debugging.
# E2E_TEST_MODE="1"
# E2E_TEST_SECRET="at-least-16-random-characters"
