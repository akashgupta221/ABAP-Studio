# ── ABAP-Studio — environment ──────────────────────────────────────
# Copy this file to `.env` and adjust. (SQLite path is relative to prisma/)

# LOCAL DEVELOPMENT (default). The database file is git-ignored and created by
# `bun run db:push`; shared content is auto-seeded on the first request.
DATABASE_URL="file:./db/app.db"

# FREE CLOUD DEPLOYMENT (Vercel Hobby + Turso free libSQL) — see DEPLOY.md
# Set both in Vercel → Project → Settings → Environment Variables.
# Also export them in your shell when running `bun run deploy:db` (schema + content push).
# TURSO_DATABASE_URL="libsql://your-db-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."      # created with: turso db tokens create <db>

# ── Owner administration ───────────────────────────────────────────────
# The single owner account. It must also have role=OWNER in the User table
# (scripts/provision-owner.ts does both). Owner access fails closed if neither
# identity is configured. OWNER_EMAIL is authoritative when set; it must match
# the verified email stored on the owner row. OWNER_USERNAME is the interim
# built-in-auth fallback. Do not set a public/shared owner identity.
# OWNER_EMAIL="owner@example.com"
# OWNER_USERNAME="YOUR_OWNER_NAME"

# ── Clerk authentication (primary) ─────────────────────────────────────
# Create/claim the application in Clerk, enable Email OTP + Google, then put the
# keys in Vercel (not in Git). Never paste secret keys into chat or issues.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# CLERK_WEBHOOK_SECRET="whsec_..."   # Clerk → Webhooks signing secret
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Temporary cutover policy: full | fallback | off.
# `fallback` accepts legacy logon for existing accounts but blocks new password
# registrations. Set `off` only after every account has been linked by verified
# email. Local API tests use `full`.
# LEGACY_AUTH_MODE="fallback"
# NEXT_PUBLIC_LEGACY_AUTH_MODE="fallback"

# ── Built-in authentication (legacy fallback, retire after cutover) ────
# Required in production; the app refuses to sign legacy sessions with the
# public development fallback. Generate with: openssl rand -base64 48
# AUTH_SECRET="..."
