# ── ABAP Workbench — environment ────────────────────────────────────────
# Copy this file to `.env` and adjust. (SQLite path is relative to prisma/)

# LOCAL DEVELOPMENT (default — ships with seeded prisma/db/app.db)
DATABASE_URL="file:./db/app.db"

# FREE CLOUD DEPLOYMENT (Vercel Hobby + Neon free Postgres):
# 1) In prisma/schema.prisma change provider = "sqlite"  ->  "postgresql"
# 2) Uncomment the line below and paste your Neon connection string
#    (Neon Dashboard -> Project -> Connection string -> "pooled" URI)
# 3) bun run db:push && bun run seed
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
